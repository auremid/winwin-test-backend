POSTGRES_DB=winwin
POSTGRES_USER=winwin
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Base64-encoded secret that decodes to at least 32 bytes: openssl rand -base64 32
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
# Shared random secret: openssl rand -hex 32
INTERNAL_TOKEN=replace-with-output-of-openssl-rand-hex-32
# Optional host-port overrides (container ports remain 8080 and 8081)
# AUTH_API_PORT=8080
# DATA_API_PORT=8081
